{
  "name": "mycasefiles",
  "version": "0.1.2",
  "description": "Desktop legal document management system for self-represented litigants",
  "author": "MyCaseFiles",
  "private": true,
  "homepage": "./",
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.6.4",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "electron-is-dev": "^3.0.1",
    "node-poppler": "^8.0.4",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-scripts": "5.0.1",
    "tesseract.js": "^6.0.1",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "dev": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "electron": "electron public/electron.js",
    "electron-dev": "ELECTRON_IS_DEV=true electron public/electron.js",
    "dev-electron": "npm run build && npm run electron",
    "build-electron": "npm run build && electron-builder",
    "dist": "npm run build && electron-builder --win --publish=never",
    "dist-publish": "npm run build && electron-builder --publish=always",
    "version-patch": "npm version patch && git push origin master --tags",
    "version-minor": "npm version minor && git push origin master --tags",
    "version-major": "npm version major && git push origin master --tags",
    "trigger-build": "gh workflow run 'Build Test'",
    "trigger-release-build": "gh workflow run 'Build and Release'",
    "build-status": "gh run list --workflow='Build Test' --limit 5",
    "watch-build": "gh run watch",
    "build-menu": "./scripts/build.sh"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "electron": "^37.2.5",
    "electron-builder": "^26.0.12",
    "typescript": "^4.9.5"
  },
  "main": "public/electron.js",
  "build": {
    "appId": "com.mycasefiles.app",
    "productName": "My Case Files",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "public/electron.js",
      "public/preload.js",
      "node_modules/**/*",
      "!node_modules/.cache/**/*",
      "!node_modules/fsevents/**/*"
    ],
    "publish": {
      "provider": "github",
      "private": true,
      "releaseType": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/logo512.png",
      "legalTrademarks": "MyCaseFiles"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "My Case Files"
    },
    "mac": {
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
